# ── ReplyPilot environment ────────────────────────────────────────────────
# Local zero-setup default. For production switch prisma/schema.prisma
# provider to "postgresql" and use:
# DATABASE_URL="postgresql://replypilot:replypilot@localhost:5432/replypilot?schema=public"
DATABASE_URL="file:./dev.db"

# Master key used to encrypt every stored OAuth token (AES-256-GCM).
# CHANGE THIS IN PRODUCTION. 32+ chars.
APP_SECRET="change-me-to-a-long-random-string-please-32chars"

# Session signing key (JWT). CHANGE IN PRODUCTION.
AUTH_SECRET="change-me-too-another-long-random-string-32chars"

# Public base URL of this app. Webhook endpoints are derived from it.
# In production: https://app.yourdomain.com
APP_URL="http://localhost:3000"

# First admin account created by `npm run setup`
BOOTSTRAP_EMAIL="admin@replypilot.local"
BOOTSTRAP_PASSWORD="replypilot123"
BOOTSTRAP_WORKSPACE="My Brand"

# ── AI provider (pick one; keys are optional until you use them) ──────────
# 1 = use the built-in deterministic MOCK provider so you can exercise the whole
# pipeline (ingest -> score -> route -> send) with zero API cost. Every mock
# reply is prefixed [MOCK] and Settings shows a warning banner.
# LEAVE THIS AT "0" IN PRODUCTION — set it to "1" only to try the app locally
# before you have an API key.
AI_MOCK="0"
# provider: openai | anthropic | google | groq | openrouter | ollama
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
GOOGLE_API_KEY=""
GOOGLE_MODEL="gemini-2.0-flash"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
EMBED_MODEL="text-embedding-3-small"

# ── Platform credentials (fill in what you have) ──────────────────────────
# Meta (Facebook Pages + Instagram + Messenger)
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="replypilot-meta-verify"
META_API_VERSION="v23.0"
# When using "Instagram Login with Instagram API" instead of Facebook Login:
IG_CLIENT_ID=""
IG_CLIENT_SECRET=""

# TikTok (Business Messaging / Comment API — partner gated, see docs)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_VERIFY_TOKEN="replypilot-tiktok-verify"

# Google / YouTube Data API v3
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# LinkedIn (Community Management API access required)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_VERIFY_TOKEN="replypilot-linkedin-verify"

# X (Twitter) v2
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_API_KEY=""
X_API_KEY_SECRET=""
X_BEARER_TOKEN=""
X_WEBHOOK_URL=""

# Worker
WORKER_CONCURRENCY="4"
POLL_INTERVAL_SECONDS="120"
# Set to "1" to run the background worker inside `next dev` (not for serverless prod)
ENABLE_INPROC_WORKER="1"

# ── Optional: protect the external cron hook GET /api/jobs/run?key=... ─────
# CRON_SECRET=""
